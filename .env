# Réglages d'ALERTE 3D (lus par docker compose). Voir le tableau « Réglages » du README.
# Temps réel : 1 s simulée = 1 s réelle (un run 09:00 -> 10:00 dure 1 h). 10 = accéléré pour tester.
TIME_SCALE=1
MODE=async
SCENARIO=pont_ferme
N_AGENTS=100
LLM_AGENTS=A04,A05,A06,A11
# habitants générés (au-delà des 12 de la fiche) qui pensent aussi avec un LLM, un sur deux avec le grand modèle
LLM_EXTRA=16
LLM_PROVIDER=ollama
LLM_BIG=qwen2.5:7b
LLM_SMALL=qwen2.5:0.5b
EMBED_MODEL=nomic-embed-text
LLM_PARALLEL=2
LLM_TIMEOUT=90
THINK_EVERY=4
# un agent LLM réfléchit au plus une fois par LLM_MIN_GAP minute(s) simulée(s), même s'il reçoit plusieurs messages
LLM_MIN_GAP=1
UPDATE_AT=09:30
RUMOR_AT=09:20
SEED=1
# etendu = quartiers Ouest et Est + 3 refuges (240 m de large). fiche = plan exact de la fiche (120 m, 2 refuges).
MONDE=etendu
# 1 = plan exact de la fiche (120 m x 80 m). 2 = quartier deux fois plus étendu (écart à la fiche).
WORLD_SCALE=1
