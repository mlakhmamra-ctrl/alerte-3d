# Réglages publics d'ALERTE 3D (lus par docker compose). Voir le tableau « Réglages » du README.
# Pour changer un réglage chez vous, ou mettre un secret (LLM_API_KEY), écrivez-le dans .env : ce fichier
# remplace les valeurs ci-dessous et n'est jamais envoyé sur GitHub (.gitignore). Ne mettez aucun secret ici.
# Temps réel : 1 s simulée = 1 s réelle (un run 09:00 -> 10:00 dure 1 h). 10 = accéléré pour tester.
TIME_SCALE=1
MODE=async
SCENARIO=pont_ferme
N_AGENTS=100
LLM_AGENTS=A04,A05,A06,A11
# habitants générés (au-delà des 12 de la fiche) qui pensent aussi avec un LLM, un sur deux avec le grand modèle
LLM_EXTRA=16
LLM_PROVIDER=ollama
# Plusieurs API LLM à la fois : chaque appel va à la moins chargée, et à la suivante si l'une tombe (quota, erreur).
# local = Ollama (ou LLM_PROVIDER/LLM_API_URL ci-dessus). Pour ajouter une API NOM (compatible OpenAI), mettez dans .env :
#   LLM_BACKENDS=local,groq
#   LLM_GROQ_URL=https://api.groq.com/openai/v1   LLM_GROQ_KEY=...   LLM_GROQ_BIG=openai/gpt-oss-120b   LLM_GROQ_SMALL=qwen/qwen3.8-27b
#   LLM_GROQ_PARALLEL=2   LLM_GROQ_REASONING=low   (low : un modèle qui raisonne garde assez de tokens pour écrire son JSON)
# Sans « local » (LLM_BACKENDS=groq,openrouter), lancez lancer_api.bat : Ollama n'est ni lancé ni téléchargé.
LLM_BACKENDS=local
# secondes pendant lesquelles une API en échec est mise de côté
LLM_COOLDOWN=60
LLM_BIG=qwen2.5:7b
LLM_SMALL=qwen2.5:0.5b
EMBED_MODEL=nomic-embed-text
# Mémoire des habitants et RAG : postgres (service postgres du docker compose, repli en RAM si la base ne répond pas) ou ram
MEMOIRE=postgres
# Poids du sens dans le rappel des souvenirs (0 = mots seuls ; 0.5 = meilleur réglage du banc, python eval_rag.py souvenirs)
SOUVENIR_SENS=0.5
# PG_DSN=postgresql://postgres:alerte@postgres:5432/alerte
LLM_PARALLEL=2
LLM_TIMEOUT=90
THINK_EVERY=4
# un agent LLM réfléchit au plus une fois par LLM_MIN_GAP minute(s) simulée(s), même s'il reçoit plusieurs messages
LLM_MIN_GAP=1
UPDATE_AT=09:30
RUMOR_AT=09:20
SEED=1
# vitesse de montée de l'eau : lente, rapide (fiche) ou eclair (l'eau monte en quelques minutes)
CRUE=rapide
# heure à laquelle le réseau mobile tombe (téléphone et groupe du quartier coupés) ; none = jamais
PANNE_RESEAU=none
# minutes qu'un habitant prêt attend les autres membres de son foyer avant de partir seul
FAMILY_WAIT=5
# etendu = quartiers Ouest et Est + 3 refuges (240 m de large). fiche = plan exact de la fiche (120 m, 2 refuges).
MONDE=etendu
# 1 = plan exact de la fiche (120 m x 80 m). 2 = quartier deux fois plus étendu (écart à la fiche).
WORLD_SCALE=1
